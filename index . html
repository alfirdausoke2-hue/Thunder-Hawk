<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skies of Thunder - Jet Fighter Game</title>
    <!-- Tailwind CSS for modern UI styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #050515;
            color: #ffffff;
            overflow: hidden;
            user-select: none;
        }
        .orbitron {
            font-family: 'Orbitron', sans-serif;
        }
        canvas {
            display: block;
            background: linear-gradient(to bottom, #020024, #090979, #00d4ff);
        }
        .hud-panel {
            background: rgba(10, 10, 30, 0.7);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(0, 212, 255, 0.3);
        }
        .jet-card {
            transition: all 0.3s ease;
        }
        .jet-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px -5px rgba(0, 212, 255, 0.4);
        }
        .jet-card.selected {
            border-color: #00d4ff;
            background: rgba(0, 212, 255, 0.15);
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col items-center justify-center relative">

    <!-- Main Menu Container -->
    <div id="mainMenu" class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-[#050515] bg-opacity-95 p-4 overflow-y-auto">
        <div class="text-center mb-6">
            <h1 class="orbitron text-5xl md:text-7xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-600 tracking-wider mb-2 drop-shadow-[0_5px_15px_rgba(0,212,255,0.4)]">
                SKIES OF THUNDER
            </h1>
            <p class="text-gray-400 text-sm md:text-base">Pilih jet tempur terbaikmu dan taklukkan langit!</p>
        </div>

        <!-- Jet Selection Grid -->
        <div class="w-full max-w-5xl mb-8">
            <h2 class="orbitron text-xl text-cyan-300 mb-4 text-center font-bold"><i class="fa-solid fa-jet-fighter mr-2"></i> Pilih Armada Jet Tempur</h2>
            <div id="jetGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 px-2">
                <!-- Jet cards will be dynamically inserted here -->
            </div>
        </div>

        <!-- Start Game Button -->
        <button id="startBtn" onclick="startGame()" class="orbitron px-8 py-4 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-lg rounded-xl shadow-[0_0_20px_rgba(0,212,255,0.5)] transition-all transform hover:scale-105 active:scale-95 flex items-center gap-3">
            <i class="fa-solid fa-play"></i> MULAI MISI
        </button>
    </div>

    <!-- Game HUD Overlay -->
    <div id="gameHud" class="absolute top-0 left-0 w-full p-4 flex justify-between items-center z-10 pointer-events-none hidden">
        <div class="flex items-center gap-6">
            <div class="hud-panel px-4 py-2 rounded-xl flex items-center gap-3">
                <i class="fa-solid fa-heart text-red-500 text-xl animate-pulse"></i>
                <div>
                    <div class="text-xs text-gray-400 font-semibold uppercase">Armor</div>
                    <div id="hudHp" class="orbitron font-bold text-lg text-red-400">100 / 100</div>
                </div>
            </div>
            <div class="hud-panel px-4 py-2 rounded-xl flex items-center gap-3">
                <i class="fa-solid fa-shield text-cyan-400 text-xl"></i>
                <div>
                    <div class="text-xs text-gray-400 font-semibold uppercase">Perisai</div>
                    <div id="hudShield" class="orbitron font-bold text-lg text-cyan-300">100%</div>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-6">
            <div class="hud-panel px-4 py-2 rounded-xl text-right">
                <div class="text-xs text-gray-400 font-semibold uppercase">Skor</div>
                <div id="hudScore" class="orbitron font-bold text-xl text-yellow-400">0</div>
            </div>
            <button onclick="returnToMenu()" class="pointer-events-auto hud-panel px-3 py-2 rounded-xl text-gray-300 hover:text-white hover:bg-red-600/50 transition-colors">
                <i class="fa-solid fa-pause"></i>
            </button>
        </div>
    </div>

    <!-- Mobile Touch Controls Overlay -->
    <div id="touchControls" class="absolute inset-0 z-10 pointer-events-none hidden flex flex-col justify-between p-6">
        <div class="flex justify-between w-full">
            <!-- Left joystick area indicator -->
            <div class="w-32 h-32 rounded-full border-2 border-white/20 bg-white/5 flex items-center justify-center text-white/30 text-xs">Geser untuk Gerak</div>
        </div>
        <div class="flex justify-end w-full">
            <button id="fireBtn" class="pointer-events-auto w-20 h-20 rounded-full bg-cyan-500/40 border-2 border-cyan-400 flex items-center justify-center text-cyan-200 text-2xl active:bg-cyan-500/70 shadow-lg">
                <i class="fa-solid fa-crosshairs"></i>
            </button>
        </div>
    </div>

    <!-- Game Over Screen -->
    <div id="gameOverScreen" class="absolute inset-0 z-30 flex flex-col items-center justify-center bg-[#050515]/95 hidden p-4">
        <div class="hud-panel p-8 rounded-2xl max-w-md w-full text-center border-red-500/40">
            <h2 class="orbitron text-4xl font-extrabold text-red-500 mb-2 drop-shadow-[0_0_10px_rgba(239,68,68,0.5)]">MISI GAGAL</h2>
            <p class="text-gray-400 mb-6">Pesawatmu berhasil dihancurkan oleh musuh.</p>
            <div class="bg-black/40 p-4 rounded-xl mb-6 space-y-2">
                <div class="flex justify-between text-sm"><span class="text-gray-400">Skor Akhir:</span> <span id="finalScore" class="orbitron text-yellow-400 font-bold">0</span></div>
                <div class="flex justify-between text-sm"><span class="text-gray-400">Musuh Dihancurkan:</span> <span id="finalKills" class="orbitron text-cyan-400 font-bold">0</span></div>
            </div>
            <div class="flex gap-4">
                <button onclick="restartGame()" class="flex-1 py-3 bg-cyan-500 hover:bg-cyan-400 text-white font-bold rounded-xl transition-colors shadow-lg">Main Lagi</button>
                <button onclick="returnToMenu()" class="flex-1 py-3 bg-gray-700 hover:bg-gray-600 text-white font-bold rounded-xl transition-colors">Menu Utama</button>
            </div>
        </div>
    </div>

    <!-- Game Canvas -->
    <canvas id="gameCanvas" class="w-full h-full"></canvas>

    <script>
        // Jet Aircraft Catalog with unique attributes
        const jets = [
            {
                id: 'f22',
                name: 'F-22 Raptor',
                role: 'Air Superiority',
                speed: 7,
                fireRate: 12, // Lower is faster
                damage: 25,
                hp: 120,
                color: '#94a3b8',
                accentColor: '#38bdf8',
                desc: 'Jet tempur siluman dengan keseimbangan kecepatan dan daya serang tinggi.',
                icon: 'fa-jet-fighter'
            },
            {
                id: 'su57',
                name: 'Su-57 Felon',
                role: 'Heavy Interceptor',
                speed: 6,
                fireRate: 15,
                damage: 35,
                hp: 150,
                color: '#475569',
                accentColor: '#ef4444',
                desc: 'Memiliki daya tahan tinggi dan daya tembak misil ganda yang kuat.',
                icon: 'fa-fighter-jet'
            },
            {
                id: 'rafale',
                name: 'Dassault Rafale',
                role: 'Multi-Role',
                speed: 8,
                fireRate: 10,
                damage: 20,
                hp: 100,
                color: '#1e293b',
                accentColor: '#eab308',
                desc: 'Sangat lincah dan memiliki kecepatan tembak peluru yang sangat cepat.',
                icon: 'fa-plane-up'
            },
            {
                id: 'f35',
                name: 'F-35 Lightning II',
                role: 'Strike Fighter',
                speed: 6.5,
                fireRate: 14,
                damage: 30,
                hp: 130,
                color: '#334155',
                accentColor: '#10b981',
                desc: 'Teknologi avionik canggih dengan serangan presisi mematikan.',
                icon: 'fa-jet-fighter-up'
            }
        ];

        let selectedJetIndex = 0;

        // Render Jet Selection Cards
        function renderJetSelection() {
            const grid = document.getElementById('jetGrid');
            grid.innerHTML = '';
            jets.forEach((jet, index) => {
                const isSelected = index === selectedJetIndex;
                grid.innerHTML += `
                    <div onclick="selectJet(${index})" class="jet-card hud-panel p-4 rounded-xl cursor-pointer border ${isSelected ? 'selected' : 'border-gray-800'} flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-center mb-2">
                                <i class="fa-solid ${jet.icon} text-2xl" style="color: ${jet.accentColor}"></i>
                                <span class="text-xs px-2 py-1 rounded bg-black/50 text-gray-300 font-semibold">${jet.role}</span>
                            </div>
                            <h3 class="orbitron font-bold text-lg text-white mb-1">${jet.name}</h3>
                            <p class="text-xs text-gray-400 mb-4">${jet.desc}</p>
                        </div>
                        <div class="space-y-2 text-xs">
                            <div>
                                <div class="flex justify-between text-gray-400 mb-1"><span>Kecepatan</span><span>${jet.speed * 10}%</span></div>
                                <div class="w-full bg-gray-800 h-1.5 rounded-full overflow-hidden"><div class="bg-cyan-400 h-full" style="width: ${jet.speed * 10}%"></div></div>
                            </div>
                            <div>
                                <div class="flex justify-between text-gray-400 mb-1"><span>Daya Tahan</span><span>${jet.hp}%</span></div>
                                <div class="w-full bg-gray-800 h-1.5 rounded-full overflow-hidden"><div class="bg-red-400 h-full" style="width: ${jet.hp}%"></div></div>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        function selectJet(index) {
            selectedJetIndex = index;
            renderJetSelection();
        }

        renderJetSelection();

        // Game Variables
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        let gameRunning = false;
        let score = 0;
        let kills = 0;
        let frameCount = 0;

        let player = {
            x: 0,
            y: 0,
            width: 50,
            height: 60,
            speed: 0,
            hp: 100,
            maxHp: 100,
            shield: 100,
            fireCooldown: 0,
            jetData: null
        };

        let bullets = [];
        let enemies = [];
        let particles = [];
        let stars = [];

        // Input Tracking
        const keys = {};
        let touchX = null;
        let touchY = null;
        let isTouching = false;

        window.addEventListener('keydown', (e) => keys[e.code] = true);
        window.addEventListener('keyup', (e) => keys[e.code] = false);

        canvas.addEventListener('touchstart', (e) => {
            isTouching = true;
            touchX = e.touches[0].clientX;
            touchY = e.touches[0].clientY;
        });

        canvas.addEventListener('touchmove', (e) => {
            if (!isTouching) return;
            touchX = e.touches[0].clientX;
            touchY = e.touches[0].clientY;
        });

        canvas.addEventListener('touchend', () => {
            isTouching = false;
        });

        document.getElementById('fireBtn').addEventListener('touchstart', (e) => {
            e.preventDefault();
            keys['Space'] = true;
        });
        document.getElementById('fireBtn').addEventListener('touchend', (e) => {
            e.preventDefault();
            keys['Space'] = false;
        });

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // Initialize Starfield Background
        function initStars() {
            stars = [];
            for (let i = 0; i < 100; i++) {
                stars.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    size: Math.random() * 2 + 0.5,
                    speed: Math.random() * 3 + 1
                });
            }
        }

        function startGame() {
            document.getElementById('mainMenu').classList.add('hidden');
            document.getElementById('gameHud').classList.remove('hidden');
            if ('ontouchstart' in window || navigator.maxTouchPoints > 0) {
                document.getElementById('touchControls').classList.remove('hidden');
            }

            const chosen = jets[selectedJetIndex];
            player.jetData = chosen;
            player.maxHp = chosen.hp;
            player.hp = chosen.hp;
            player.speed = chosen.speed;
            player.x = canvas.width / 2 - player.width / 2;
            player.y = canvas.height - 120;
            player.shield = 100;

            score = 0;
            kills = 0;
            bullets = [];
            enemies = [];
            particles = [];
            frameCount = 0;

            initStars();
            gameRunning = true;
            requestAnimationFrame(gameLoop);
        }

        function returnToMenu() {
            gameRunning = false;
            document.getElementById('gameHud').classList.add('hidden');
            document.getElementById('touchControls').classList.add('hidden');
            document.getElementById('gameOverScreen').classList.add('hidden');
            document.getElementById('mainMenu').classList.remove('hidden');
        }

        function restartGame() {
            document.getElementById('gameOverScreen').classList.add('hidden');
            startGame();
        }

        function gameOver() {
            gameRunning = false;
            document.getElementById('gameHud').classList.add('hidden');
            document.getElementById('touchControls').classList.add('hidden');
            document.getElementById('finalScore').innerText = score;
            document.getElementById('finalKills').innerText = kills;
            document.getElementById('gameOverScreen').classList.remove('hidden');
        }

        // Spawn Enemies
        function spawnEnemy() {
            const types = ['drone', 'fighter', 'bomber'];
            const type = types[Math.floor(Math.random() * types.length)];
            let width = 45, height = 45, hp = 40, speed = 3, points = 100;

            if (type === 'fighter') {
                width = 50; height = 55; hp = 70; speed = 2.5; points = 200;
            } else if (type === 'bomber') {
                width = 70; height = 70; hp = 150; speed = 1.5; points = 400;
            }

            enemies.push({
                x: Math.random() * (canvas.width - width),
                y: -100,
                width: width,
                height: height,
                hp: hp,
                maxHp: hp,
                speed: speed,
                type: type,
                shootTimer: Math.random() * 50
            });
        }

        // Create Particle Explosion
        function createExplosion(x, y, color) {
            for (let i = 0; i < 20; i++) {
                particles.push({
                    x: x,
                    y: y,
                    vx: (Math.random() - 0.5) * 8,
                    vy: (Math.random() - 0.5) * 8,
                    size: Math.random() * 4 + 2,
                    color: color,
                    alpha: 1,
                    decay: Math.random() * 0.03 + 0.01
                });
            }
        }

        // Update Game State
        function update() {
            frameCount++;

            // Background Stars movement
            stars.forEach(star => {
                star.y += star.speed;
                if (star.y > canvas.height) {
                    star.y = 0;
                    star.x = Math.random() * canvas.width;
                }
            });

            // Player Movement via Keyboard or Touch
            if (keys['ArrowLeft'] || keys['KeyA']) player.x -= player.speed;
            if (keys['ArrowRight'] || keys['KeyD']) player.x += player.speed;
            if (keys['ArrowUp'] || keys['KeyW']) player.y -= player.speed;
            if (keys['ArrowDown'] || keys['KeyS']) player.y += player.speed;

            if (isTouching && touchX !== null) {
                let dx = touchX - (player.x + player.width / 2);
                let dy = touchY - (player.y + player.height / 2);
                player.x += dx * 0.1;
                player.y += dy * 0.1;
            }

            // Boundary limits
            player.x = Math.max(0, Math.min(canvas.width - player.width, player.x));
            player.y = Math.max(0, Math.min(canvas.height - player.height, player.y));

            // Player Shooting
            if (player.fireCooldown > 0) player.fireCooldown--;
            if ((keys['Space'] || isTouching) && player.fireCooldown <= 0) {
                bullets.push({
                    x: player.x + player.width / 2 - 3,
                    y: player.y,
                    width: 6,
                    height: 18,
                    speed: 14,
                    damage: player.jetData.damage,
                    isPlayer: true
                });
                player.fireCooldown = player.jetData.fireRate;
            }

            // Update Bullets
            for (let i = bullets.length - 1; i >= 0; i--) {
                let b = bullets[i];
                b.y += b.isPlayer ? -b.speed : b.speed;

                if (b.y < -50 || b.y > canvas.height + 50) {
                    bullets.splice(i, 1);
                    continue;
                }

                // Collision Player Bullet vs Enemy
                if (b.isPlayer) {
                    for (let j = enemies.length - 1; j >= 0; j--) {
                        let e = enemies[j];
                        if (b.x < e.x + e.width && b.x + b.width > e.x &&
                            b.y < e.y + e.height && b.y + b.height > e.y) {
                            e.hp -= b.damage;
                            bullets.splice(i, 1);
                            createExplosion(b.x, b.y, '#38bdf8');

                            if (e.hp <= 0) {
                                createExplosion(e.x + e.width / 2, e.y + e.height / 2, '#f97316');
                                score += e.type === 'bomber' ? 400 : (e.type === 'fighter' ? 200 : 100);
                                kills++;
                                enemies.splice(j, 1);
                            }
                            break;
                        }
                    }
                } else {
                    // Enemy Bullet vs Player
                    if (b.x < player.x + player.width && b.x + b.width > player.x &&
                        b.y < player.y + player.height && b.y + b.height > player.y) {
                        bullets.splice(i, 1);
                        if (player.shield > 0) {
                            player.shield -= 15;
                            if (player.shield < 0) player.shield = 0;
                        } else {
                            player.hp -= 20;
                        }
                        createExplosion(b.x, b.y, '#ef4444');
                        if (player.hp <= 0) {
                            gameOver();
                        }
                    }
                }
            }

            // Spawn Enemies periodically
            if (frameCount % 60 === 0) {
                spawnEnemy();
            }

            // Update Enemies
            for (let i = enemies.length - 1; i >= 0; i--) {
                let e = enemies[i];
                e.y += e.speed;

                // Enemy shooting
                e.shootTimer++;
                if (e.shootTimer > 80) {
                    bullets.push({
                        x: e.x + e.width / 2 - 3,
                        y: e.y + e.height,
                        width: 6,
                        height: 14,
                        speed: 7,
                        isPlayer: false
                    });
                    e.shootTimer = 0;
                }

                // Enemy collision with player
                if (e.x < player.x + player.width && e.x + e.width > player.x &&
                    e.y < player.y + player.height && e.y + e.height > player.y) {
                    player.hp -= 30;
                    createExplosion(e.x, e.y, '#ef4444');
                    enemies.splice(i, 1);
                    if (player.hp <= 0) gameOver();
                    continue;
                }

                // Remove out-of-bounds enemies
                if (e.y > canvas.height + 100) {
                    enemies.splice(i, 1);
                }
            }

            // Update Particles
            for (let i = particles.length - 1; i >= 0; i--) {
                let p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.alpha -= p.decay;
                if (p.alpha <= 0) {
                    particles.splice(i, 1);
                }
            }

            // Update HUD elements
            document.getElementById('hudHp').innerText = `${Math.max(0, player.hp)} / ${player.maxHp}`;
            document.getElementById('hudShield').innerText = `${player.shield}%`;
            document.getElementById('hudScore').innerText = score;
        }

        // Render Game Graphics
        function render() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Draw Stars
            ctx.fillStyle = '#ffffff';
            stars.forEach(star => {
                ctx.globalAlpha = Math.random() * 0.5 + 0.5;
                ctx.fillRect(star.x, star.y, star.size, star.size);
            });
            ctx.globalAlpha = 1.0;

            // Draw Particles
            particles.forEach(p => {
                ctx.save();
                ctx.globalAlpha = p.alpha;
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            // Draw Bullets
            bullets.forEach(b => {
                ctx.fillStyle = b.isPlayer ? '#38bdf8' : '#ef4444';
                ctx.shadowBlur = 10;
                ctx.shadowColor = b.isPlayer ? '#38bdf8' : '#ef4444';
                ctx.fillRect(b.x, b.y, b.width, b.height);
                ctx.shadowBlur = 0;
            });

            // Draw Player Jet
            if (gameRunning) {
                ctx.save();
                ctx.translate(player.x + player.width / 2, player.y + player.height / 2);
                
                // Jet Body
                ctx.fillStyle = player.jetData.color;
                ctx.beginPath();
                ctx.moveTo(0, -player.height / 2);
                ctx.lineTo(player.width / 2, player.height / 2);
                ctx.lineTo(0, player.height / 3);
                ctx.lineTo(-player.width / 2, player.height / 2);
                ctx.closePath();
                ctx.fill();

                // Wings Accent
                ctx.fillStyle = player.jetData.accentColor;
                ctx.beginPath();
                ctx.moveTo(0, -player.height / 4);
                ctx.lineTo(player.width / 2 + 10, player.height / 4);
                ctx.lineTo(0, player.height / 4);
                ctx.closePath();
                ctx.fill();

                ctx.beginPath();
                ctx.moveTo(0, -player.height / 4);
                ctx.lineTo(-player.width / 2 - 10, player.height / 4);
                ctx.lineTo(0, player.height / 4);
                ctx.closePath();
                ctx.fill();

                // Engine flame
                ctx.fillStyle = '#f97316';
                ctx.beginPath();
                ctx.moveTo(-6, player.height / 2);
                ctx.lineTo(0, player.height / 2 + Math.random() * 15 + 10);
                ctx.lineTo(6, player.height / 2);
                ctx.closePath();
                ctx.fill();

                ctx.restore();
            }

            // Draw Enemies
            enemies.forEach(e => {
                ctx.save();
                ctx.translate(e.x + e.width / 2, e.y + e.height / 2);
                ctx.rotate(Math.PI);

                ctx.fillStyle = e.type === 'bomber' ? '#7f1d1d' : '#991b1b';
                ctx.beginPath();
                ctx.moveTo(0, -e.height / 2);
                ctx.lineTo(e.width / 2, e.height / 2);
                ctx.lineTo(0, e.height / 3);
                ctx.lineTo(-e.width / 2, e.height / 2);
                ctx.closePath();
                ctx.fill();

                ctx.restore();

                // Enemy Health bar
                ctx.fillStyle = 'rgba(0,0,0,0.5)';
                ctx.fillRect(e.x, e.y - 8, e.width, 4);
                ctx.fillStyle = '#ef4444';
                ctx.fillRect(e.x, e.y - 8, e.width * (e.hp / e.maxHp), 4);
            });
        }

        // Main Game Loop
        function gameLoop() {
            if (!gameRunning) return;
            update();
            render();
            requestAnimationFrame(gameLoop);
        }
    </script>
</body>
</html>
